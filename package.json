
{
  "name": "grafica-rabbit-financeiro",
  "version": "0.1.1",
  "description": "Sistema financeiro desktop da Gráfica Rabbit",
  "main": "main.js",
  "author": "Gráfica Rabbit",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis --publish never",
    "build:mac": "electron-builder --mac dmg zip",
    "build:mac:arm64": "electron-builder --mac dmg zip --arm64",
    "build:mac:x64": "electron-builder --mac dmg zip --x64"
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "afterPack": "./scripts/afterPack.js",
    "appId": "br.com.graficarabbit.financeiro",
    "productName": "Gráfica Rabbit Financeiro",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "grafica_rabbit_financeiro.html",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business"
    }
  }
}
